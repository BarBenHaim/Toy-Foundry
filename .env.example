# ToyFoundry — every one of these is optional except Firebase.
#
# The app runs end to end with none of the AI or payment keys set: each
# provider has a fallback that keeps the flow alive (see "Demo mode" in
# the README). What you lose without a key is quality, not the flow.

# ── Firebase (required) ──────────────────────────────────────────────
# Server: Firestore for projects and orders, Storage for files.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole PEM. Escaped \n are handled.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Browser: used only to sign in to /admin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Who runs the shop ────────────────────────────────────────────────
# Comma-separated. The first one gets the "an order needs printing"
# email. An empty list means nobody can open /admin.
ADMIN_EMAILS=

# ── Reading the drawing (Claude vision) ──────────────────────────────
# Without it: a generic creature whose palette is still sampled from the
# real drawing, marked low-confidence in the UI.
ANTHROPIC_API_KEY=
TOYFOUNDRY_VISION_MODEL=claude-sonnet-4-5

# ── Drawing the toy (OpenAI images) ──────────────────────────────────
# Without it: the drawing itself, restaged as a product shot.
OPENAI_API_KEY=
TOYFOUNDRY_IMAGE_MODEL=gpt-image-1

# ── Image to 3D (Meshy) ──────────────────────────────────────────────
# Without it, or on a failed sculpt: the procedural stand-in sculptor,
# which produces a real printable model and flags the order for review.
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai/openapi/v1

# ── Payment ──────────────────────────────────────────────────────────
# Stripe Checkout over REST. Without it, checkout is refused.
STRIPE_SECRET_KEY=
# Set to 1 ONLY on a demo deploy: it marks orders paid without charging.
TOYFOUNDRY_DEMO_PAYMENTS=
NEXT_PUBLIC_TOYFOUNDRY_CURRENCY=USD

# ── Production ───────────────────────────────────────────────────────
# With these, orders POST to the printing API. Without them, the order
# is emailed to ADMIN_EMAILS[0] with the STL, the 3MF and the address.
JLC3DP_API_URL=
JLC3DP_API_KEY=
JLC3DP_MATERIAL=PLA
JLC3DP_COLOR=white
JLC3DP_LAYER_HEIGHT=0.15
JLC3DP_INFILL=20

# ── Email (Gmail app password) ───────────────────────────────────────
# The confirmation email carries the only link back to an order.
MAIL_USER=
MAIL_PASS=

# ── Demo ─────────────────────────────────────────────────────────────
# Forces every AI step onto its fallback at once. The whole flow,
# walkable, with no keys and no spend.
TOYFOUNDRY_DEMO=
